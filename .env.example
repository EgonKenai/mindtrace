# Public Firebase Web SDK configuration. These values identify the Firebase
# project but are not Firebase Admin or Gemini secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mindtrace-demo
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Set to true for local development with Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Server-only Firebase project configuration.
FIREBASE_PROJECT_ID=mindtrace-demo
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Public origin used for same-origin state-changing API validation.
APP_ORIGIN=http://localhost:3000

# Stage 3A intentionally defines no Gemini or other AI provider secret.
# A future server-only provider key must use Secret Manager or an ignored
# local environment file and must never use a NEXT_PUBLIC_ prefix.
